# ─────────────────────────────────────────────────────────────────────────────
# RiftboundStocks environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. NEVER commit a filled-in copy — .env* is
# gitignored apart from this template.
#
# THE SITE RUNS WITH NONE OF THESE SET. The catalogue is bundled in the repo and
# prices fall back to the demo generator, so `npm run dev` works on a fresh clone
# with no configuration at all. Everything below unlocks something extra.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for absolute URLs in metadata, the
# sitemap and OpenGraph tags. On Vercel this is inferred from the deployment URL
# if unset, but set it explicitly once a custom domain is attached — otherwise
# canonicals point at the *.vercel.app host.
NEXT_PUBLIC_SITE_URL="https://riftboundstocks.com"

# Shown on /about and in the footer for corrections and takedown requests.
NEXT_PUBLIC_CONTACT_EMAIL="hello@riftboundstocks.com"

# ── Database (optional) ──────────────────────────────────────────────────────
# Only needed once you want PERSISTED daily price snapshots rather than the
# generated series. Neon, Supabase or any Postgres works; the schema is in
# prisma/schema.prisma. Variable name matches TCGEmpire's so the two projects
# can share connection strings and tooling.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#
# Then: npm run db:push && npm run prices:import
# DATABASE_URL=""

# ── TCGplayer (optional) ─────────────────────────────────────────────────────
# Setting TCGPLAYER_PUBLIC_KEY flips PRICES_ARE_DEMO to false, which removes the
# demo-data disclaimers site-wide. Do NOT set it until real prices are actually
# flowing, or the site will show generated numbers with no warning on them.
#
# The importer in src/lib/prices/tcgplayer.ts currently reads TCGplayer's public
# search endpoint (the same one their website uses) and needs no credentials.
# These are here for the official API at https://developer.tcgplayer.com/, which
# you should move to before doing anything at volume.
#
# TCGplayer's data is licensed, not public domain: attribution is required on
# every surface that displays it, it may not be presented as your own, and bulk
# redistribution is not permitted. Read their API terms before enabling this.
# TCGPLAYER_PUBLIC_KEY=""
# TCGPLAYER_PRIVATE_KEY=""

# Affiliate/partner id appended to outbound TCGplayer links. Without it the
# links still work, they just don't earn anything.
# TCGPLAYER_AFFILIATE_ID=""

# ── Cron (optional) ──────────────────────────────────────────────────────────
# Shared secret for the scheduled price refresh, so the endpoint can't be
# triggered by anyone who guesses the path. Any long random string.
# CRON_SECRET=""
