// RiftboundStocks — price snapshot + account storage.
//
// OPTIONAL. The site runs entirely without a database: the card catalogue is a
// bundled JSON file (src/data/riftbound-cards.json) and prices come from the
// generator in src/lib/prices/synthetic.ts. This schema exists for the step
// after that — persisting REAL daily TCGplayer snapshots so history accumulates
// instead of being recomputed, and (below) real user accounts.
//
// Modelled on TCGEmpire's Card + PriceHistory tables so rows are portable
// between the two projects, with two differences that matter for this site:
//   • one row carries ALL FIVE series (low/mid/market/foil/foilMarket) rather
//     than a single lowest price, because the card page plots all five and
//     five rows per card per day would quintuple the table for no gain;
//   • prices are USD cents, because TCGplayer quotes USD. Converting on write
//     would freeze one day's FX rate into permanent history.
//
// Accounts (User + AuthToken below) follow the same "optional" rule: nothing
// in src/lib/auth.ts runs unless DATABASE_URL is set (see accountsEnabled() in
// lib/site.ts) — a fresh clone with no env config still shows /login and
// /signup, just disabled, exactly like the demo-price disclaimer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A printing. Mirrors the bundled catalogue; `externalId` is the RiftScribe id
/// ("ogn-007a-298") and is the join key on both sides.
model Card {
  id              String  @id @default(cuid())
  externalId      String  @unique
  slug            String  @unique
  name            String
  setCode         String
  setName         String
  collectorNumber Int
  collectorLabel  String
  /// "a" (alt art) or "s" (Signature); null for a base print. Without this an
  /// alt art collides with the card it re-prints — they share a number.
  variant         String?
  rarity          String
  domain          String
  type            String
  imageUrl        String?
  imageThumbUrl   String?

  /// Denormalised copy of the newest snapshot, so list pages (movers, set
  /// grids, the ticker) sort and render without joining the history table.
  marketCents     Int?
  foilMarketCents Int?
  lastPricedAt    DateTime?

  /// TCGplayer product id, once matched by the importer. Null = never matched,
  /// which is "we didn't find it", NOT "it is worthless".
  tcgProductId Int?

  snapshots PriceSnapshot[]

  @@index([setCode, collectorNumber])
  @@index([marketCents])
  @@index([rarity])
  @@index([domain])
}

/// One printing's prices on one UTC calendar day — a row of the price chart.
model PriceSnapshot {
  id     String   @id @default(cuid())
  cardId String
  day    DateTime @db.Date

  /// All USD cents. Foil columns are null for printings with no foil treatment.
  lowCents        Int
  midCents        Int
  marketCents     Int
  foilCents       Int?
  foilMarketCents Int?

  /// Which adapter wrote this row ("tcgplayer", "demo"). Kept so a backfill from
  /// one source can never be silently mistaken for another's data.
  source     String   @default("tcgplayer")
  recordedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// One row per card per day: a same-day re-run updates rather than duplicating.
  @@unique([cardId, day])
  @@index([cardId, day])
  /// Serves the movers queries, which read every card across a two-day window.
  @@index([day])
}

/// An account. Mirrors the shape of TCGEmpire's User model, minus everything
/// this site has no feature for yet (wallet, marketplace, Premium billing) —
/// just enough to sign in and prove an email address.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Vestigial. Accounts are Google/Discord OAuth only now — nothing in the
  /// app can set this anymore (email/password sign-up was removed). Left as a
  /// nullable column rather than dropped, since dropping it would be a
  /// destructive migration on a live database for zero functional gain; kept
  /// only so a pre-existing row (from before the removal) isn't orphaned.
  passwordHash  String?
  displayName   String
  avatarUrl     String?
  /// Set when the email is confirmed (instantly for OAuth, which is pre-verified).
  emailVerified DateTime?
  /// OAuth identities (one per provider). Indexed rather than DB-unique so the
  /// push stays additive; uniqueness is enforced in the OAuth callback (find by
  /// provider id, then by email, then create).
  googleId      String?
  discordId     String?
  createdAt     DateTime  @default(now())

  authTokens  AuthToken[]
  priceAlerts PriceAlert[]
  collection  CollectionCard[]

  @@index([googleId])
  @@index([discordId])
}

/// A "notify me when this card's price drops" watch. Compared against the
/// live headline price (lib/prices' activeSource — real TCGplayer data once
/// imported) by the daily /api/cron/price-alerts job. lastPriceCents is the
/// baseline a drop is measured against, advanced every run so a later dip is
/// compared to the most recent price, not a stale one.
model PriceAlert {
  id             String    @id @default(cuid())
  userId         String
  /// RiftScribe id — the same join key as Card.externalId above, matching the
  /// in-memory catalogue (lib/catalog.ts's RiftCard.id) rather than a foreign
  /// key into the Card model, since every page already resolves a card that way.
  cardId         String
  lastPriceCents Int?
  unsubToken     String    @unique
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([cardId])
  @@index([unsubToken])
}

/// A card a user owns ("My Cards" / Portfolio). One row per (user, card,
/// condition, foil); quantity aggregates duplicates. costBasisCents powers the
/// unrealised-gain/loss view against the live market price — null = unknown, no
/// P&L computed for that row rather than assuming a cost of zero.
model CollectionCard {
  id             String   @id @default(cuid())
  userId         String
  cardId         String // RiftScribe id — see PriceAlert.cardId above
  condition      String   @default("NM") // NM, LP, MP, HP, DMG
  isFoil         Boolean  @default(false)
  quantity       Int      @default(1)
  costBasisCents Int?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, condition, isFoil])
  @@index([userId])
  @@index([cardId])
}

/// Vestigial. Was one-time tokens for email verification / password reset;
/// both were removed when accounts became Google/Discord OAuth only, so
/// nothing in the app creates or consumes a row here anymore. Left in place
/// (not dropped) for the same reason as User.passwordHash above.
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  purpose   String // "verify" | "reset"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
